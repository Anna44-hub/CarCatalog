<Window x:Class="CarCatalog.CarDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarCatalog"
        mc:Ignorable="d"
        Title="Детали автомобиля" Height="250" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Марка:" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock Text="{Binding Brand}" Grid.Row="0" Grid.Column="1"/>

        <TextBlock Text="Модель:" Grid.Row="1" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock Text="{Binding Model}" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Text="Год:" Grid.Row="2" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock Text="{Binding Year}" Grid.Row="2" Grid.Column="1"/>

        <TextBlock Text="Цена:" Grid.Row="3" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Grid.Row="3" Grid.Column="1"/>

        <TextBlock Text="Пробег:" Grid.Row="4" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock Text="{Binding Mileage}" Grid.Row="4" Grid.Column="1"/>

        <Button Content="Закрыть" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Width="80" Margin="0,10,0,0" Click="Close_Click"/>
    </Grid>
</Window>
